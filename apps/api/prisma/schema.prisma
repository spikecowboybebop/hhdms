generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]

  @@map("roles")
}

model User {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                 @unique @db.VarChar(255)
  passwordHash            String                 @map("password_hash") @db.VarChar(255)
  phoneNumber             String                 @unique @map("phone_number") @db.VarChar(20)
  firstNameEn             String                 @map("first_name_en") @db.VarChar(100)
  lastNameEn              String                 @map("last_name_en") @db.VarChar(100)
  firstNameBn             String?                @map("first_name_bn") @db.VarChar(100)
  lastNameBn              String?                @map("last_name_bn") @db.VarChar(100)
  nid                     String?                @map("nid") @db.VarChar(50)
  photoUrl                String?                @map("photo_url") @db.VarChar(512)
  roleId                  Int                    @map("role_id")
  status                  AccountStatusEnum      @default(ACTIVE)
  mfaEnabled              Boolean                @default(false) @map("mfa_enabled")
  mfaSecret               String?                @map("mfa_secret") @db.VarChar(128)
  lastLoginAt             DateTime?              @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt       DateTime?              @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt               DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime?              @default(now()) @map("updated_at") @db.Timestamptz(6)
  nutritionist_profilesId String?
  caregiver_profiles      caregiver_profiles?
  fcm_tokens              fcm_tokens[]
  mbbs_doctor_profiles    mbbs_doctor_profiles?
  nurse_profiles          nurse_profiles?
  nutritionist_profiles   nutritionist_profiles?
  patients                patients[]
  server_notifications    server_notifications[]
  sonologist_profiles     sonologist_profiles?
  specialist_profiles     specialist_profiles?
  chat_doctor_conversations chat_conversations[]
  role                    Role                   @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  @@map("users")
}

model mbbs_doctor_profiles {
  user_id             String                       @id @map("user_id") @db.Uuid
  license_number      String                       @unique @map("license_number") @db.VarChar(50)
  bmdc_registration   String?                      @unique @map("bmdc_registration") @db.VarChar(50)
  specialization      String?                      @map("specialization") @db.VarChar(100)
  qualification       String?                      @map("qualification") @db.VarChar(255)
  years_of_experience Int?                         @map("years_of_experience")
  consultation_fee    Decimal?                     @map("consultation_fee") @db.Decimal(10, 2)
  signature_url       String?                      @map("signature_url") @db.VarChar(512)
  district            String?                      @map("district") @db.VarChar(100)
  thana               String?                      @map("thana") @db.VarChar(100)
  service_area        String?                      @map("service_area") @db.VarChar(255)
  is_available        Boolean                      @default(true) @map("is_available")
  created_at          DateTime?                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime?                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  test_orders         diagnostic_test_orders[]
  patient_assignments doctor_patient_assignments[]
  emergency_flags     emergency_flags[]
  user                User                         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  diagnoses           patient_diagnoses[]
  diagnosis_reports   patient_diagnosis_reports[]
  vital_signs         patient_vital_signs[]
  prescriptions       prescriptions[]
  schedules           provider_schedules[]
  referrals           specialist_referrals[]

  @@map("mbbs_doctor_profiles")
}

model provider_schedules {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id  String               @map("provider_id") @db.Uuid
  day_of_week  Int                  @map("day_of_week")
  start_time   String               @map("start_time") @db.VarChar(5)
  end_time     String               @map("end_time") @db.VarChar(5)
  is_available Boolean              @default(true) @map("is_available")
  created_at   DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at   DateTime?            @default(now()) @map("updated_at") @db.Timestamptz(6)
  provider     mbbs_doctor_profiles @relation(fields: [provider_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider_id, day_of_week, start_time])
  @@map("provider_schedules")
}

model fcm_tokens {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @map("user_id") @db.Uuid
  token       String
  device_type String   @default("android") @map("device_type") @db.VarChar(20)
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, token])
  @@map("fcm_tokens")
}

model server_notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @map("user_id") @db.Uuid
  title      String   @db.VarChar(255)
  body       String
  session_id String?  @map("session_id") @db.Uuid
  type       String?  @db.VarChar(50)
  delivered  Boolean  @default(false)
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  patient_id String?  @map("patient_id") @db.VarChar(50)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, delivered])
  @@map("server_notifications")
}

model nutritionist_profiles {
  id                     String                                @id @default(uuid())
  user_id                String                                @unique @db.Uuid
  qualifications         String?                               @db.VarChar(255)
  specializations        String?                               @db.VarChar(255)
  service_area           String?                               @db.VarChar(255)
  consultation_fee       Decimal?                              @db.Decimal(10, 2)
  is_available           Boolean                               @default(true)
  created_at             DateTime                              @default(now())
  updated_at             DateTime                              @updatedAt
  adherence_logs         nutritionist_adherence_logs[]
  anthropometric_records nutritionist_anthropometric_records[]
  diet_plans             nutritionist_diet_plans[]
  follow_ups             nutritionist_follow_ups[]
  user                   User                                  @relation(fields: [user_id], references: [id])
}

model nutritionist_anthropometric_records {
  id           String                @id @default(uuid())
  patient_id   String                @db.Uuid
  recorded_by  String                @db.Uuid
  height_cm    Float?
  weight_kg    Float?
  waist_cm     Float?
  hip_cm       Float?
  bmi          Float?
  bmi_category String?
  notes        String?
  recorded_at  DateTime              @default(now())
  patient      patients              @relation(fields: [patient_id], references: [id])
  nutritionist nutritionist_profiles @relation(fields: [recorded_by], references: [user_id])
}

model nutritionist_diet_plans {
  id              String                         @id @default(uuid())
  patient_id      String                         @db.Uuid
  nutritionist_id String                         @db.Uuid
  title           String
  condition_name  String?
  total_calories  Int?
  language        String                         @default("en")
  notes           String?
  status          String                         @default("ACTIVE")
  created_at      DateTime                       @default(now())
  updated_at      DateTime                       @updatedAt
  meals           nutritionist_diet_plan_meals[]
  nutritionist    nutritionist_profiles          @relation(fields: [nutritionist_id], references: [user_id])
  patient         patients                       @relation(fields: [patient_id], references: [id])
  follow_ups      nutritionist_follow_ups[]
}

model nutritionist_diet_plan_meals {
  id                   String                  @id @default(uuid())
  plan_id              String
  meal_slot            String
  calories             Int?
  preparation_guidance String?
  foods_json           String
  sort_order           Int                     @default(0)
  plan                 nutritionist_diet_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade)
}

model nutritionist_follow_ups {
  id               String                   @id @default(uuid())
  patient_id       String                   @db.Uuid
  nutritionist_id  String                   @db.Uuid
  plan_id          String?
  interval         String
  follow_up_at     DateTime?
  reminder_channel String                   @default("SMS")
  status           String                   @default("SCHEDULED")
  notes            String?
  created_at       DateTime                 @default(now())
  nutritionist     nutritionist_profiles    @relation(fields: [nutritionist_id], references: [user_id])
  patient          patients                 @relation(fields: [patient_id], references: [id])
  plan             nutritionist_diet_plans? @relation(fields: [plan_id], references: [id])
}

model nutritionist_adherence_logs {
  id              String                @id @default(uuid())
  patient_id      String                @db.Uuid
  nutritionist_id String                @db.Uuid
  plan_id         String?
  follow_up_id    String?
  adherence_score Int
  weight_kg       Float?
  challenges      String?
  modifications   String?
  logged_at       DateTime              @default(now())
  nutritionist    nutritionist_profiles @relation(fields: [nutritionist_id], references: [user_id])
  patient         patients              @relation(fields: [patient_id], references: [id])
}

model food_items {
  id         String   @id @default(uuid())
  name_en    String
  name_bn    String?
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model diet_templates {
  id             String                @id @default(uuid())
  condition_name String                @unique
  description    String?
  total_calories Int
  language       String                @default("en")
  is_active      Boolean               @default(true)
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt
  meals          diet_template_meals[]
}

model diet_template_meals {
  id                   String         @id @default(uuid())
  template_id          String
  meal_slot            String
  calories             Int?
  preparation_guidance String?
  foods_json           String
  sort_order           Int            @default(0)
  template             diet_templates @relation(fields: [template_id], references: [id], onDelete: Cascade)
}

model specialist_profiles {
  user_id             String                   @id @map("user_id") @db.Uuid
  license_number      String                   @unique @map("license_number") @db.VarChar(50)
  bmdc_registration   String?                  @unique @map("bmdc_registration") @db.VarChar(50)
  specialty_code      String                   @map("specialty_code") @db.VarChar(20)
  qualification       String?                  @map("qualification") @db.VarChar(255)
  years_of_experience Int?                     @map("years_of_experience")
  consultation_fee    Decimal?                 @map("consultation_fee") @db.Decimal(10, 2)
  signature_url       String?                  @map("signature_url") @db.VarChar(512)
  sub_specialties     String?                  @map("sub_specialties") @db.VarChar(255)
  service_area        String?                  @map("service_area") @db.VarChar(255)
  is_available        Boolean                  @default(true) @map("is_available")
  created_at          DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime?                @default(now()) @map("updated_at") @db.Timestamptz(6)
  test_orders         diagnostic_test_orders[]
  prescriptions       prescriptions[]
  user                User                     @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  assigned_referrals  specialist_referrals[]

  @@map("specialist_profiles")
}

model sonologist_profiles {
  user_id             String               @id @map("user_id") @db.Uuid
  license_number      String?              @unique @map("license_number") @db.VarChar(50)
  qualification       String?              @map("qualification") @db.VarChar(255)
  years_of_experience Int?                 @map("years_of_experience")
  consultation_fee    Decimal?             @map("consultation_fee") @db.Decimal(10, 2)
  equipment_ids       String?              @map("equipment_ids") @db.VarChar(500)
  usg_specializations String?              @map("usg_specializations") @db.VarChar(255)
  is_available        Boolean              @default(true) @map("is_available")
  created_at          DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime?            @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                User                 @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  reports             sonologist_reports[]
  studies             sonologist_studies[]

  @@map("sonologist_profiles")
}

model sonologist_studies {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sonologist_id     String               @map("sonologist_id") @db.Uuid
  patient_id        String               @map("patient_id") @db.Uuid
  modality          String               @default("USG") @map("modality") @db.VarChar(20)
  body_part         String?              @map("body_part") @db.VarChar(100)
  study_date        DateTime?            @default(now()) @map("study_date") @db.Timestamptz(6)
  dicom_series_uids String?              @map("dicom_series_uids")
  storage_url       String?              @map("storage_url") @db.VarChar(2000)
  findings          String?              @map("findings")
  impression        String?              @map("impression")
  is_abnormal       Boolean              @default(false) @map("is_abnormal")
  status            String               @default("COMPLETED") @map("status") @db.VarChar(20)
  created_at        DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime?            @default(now()) @map("updated_at") @db.Timestamptz(6)
  reports           sonologist_reports[]
  patient           patients             @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sonologist        sonologist_profiles  @relation(fields: [sonologist_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sonologist_studies")
}

model sonologist_reports {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_id              String              @map("study_id") @db.Uuid
  sonologist_id         String              @map("sonologist_id") @db.Uuid
  patient_id            String              @map("patient_id") @db.Uuid
  findings              String              @map("findings")
  impression            String?             @map("impression")
  annotated_images      String?             @map("annotated_images")
  digital_signature_url String?             @map("digital_signature_url") @db.VarChar(512)
  report_date           DateTime?           @default(now()) @map("report_date") @db.Timestamptz(6)
  created_at            DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  patient               patients            @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sonologist            sonologist_profiles @relation(fields: [sonologist_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  study                 sonologist_studies  @relation(fields: [study_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sonologist_reports")
}

model caregiver_profiles {
  user_id             String                          @id @map("user_id") @db.Uuid
  gender              String?                         @map("gender") @db.VarChar(10)
  experience_years    Int?                            @map("experience_years")
  specializations     String?                         @map("specializations")
  verification_status String                          @default("PENDING") @map("verification_status") @db.VarChar(20)
  training_certs      String?                         @map("training_certs")
  rating              Decimal?                        @map("rating") @db.Decimal(2, 1)
  phone_number        String?                         @map("phone_number") @db.VarChar(20)
  address             String?                         @map("address") @db.VarChar(255)
  is_available        Boolean                         @default(true) @map("is_available")
  created_at          DateTime?                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime?                       @default(now()) @map("updated_at") @db.Timestamptz(6)
  activity_logs       caregiver_activity_logs[]
  condition_reports   caregiver_condition_reports[]
  patient_assignments caregiver_patient_assignments[]
  user                User                            @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  check_in_outs       caregiver_check_in_out[]
  timesheets          caregiver_timesheets[]

  @@map("caregiver_profiles")
}

model caregiver_patient_assignments {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver_id String             @map("caregiver_id") @db.Uuid
  patient_id   String             @map("patient_id") @db.Uuid
  service_type String?            @map("service_type") @db.VarChar(20)
  patient_type String?            @map("patient_type") @db.VarChar(20)
  assigned_at  DateTime?          @default(now()) @map("assigned_at") @db.Timestamptz(6)
  status       String             @default("ACTIVE") @map("status") @db.VarChar(20)
  caregiver    caregiver_profiles @relation(fields: [caregiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  patient      patients           @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([caregiver_id, patient_id])
  @@map("caregiver_patient_assignments")
}

model caregiver_activity_logs {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver_id  String             @map("caregiver_id") @db.Uuid
  patient_id    String             @map("patient_id") @db.Uuid
  shift_date    DateTime?          @default(now()) @map("shift_date") @db.Date
  activity_type String             @map("activity_type") @db.VarChar(30)
  notes         String?            @map("notes")
  created_at    DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  caregiver     caregiver_profiles @relation(fields: [caregiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  patient       patients           @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("caregiver_activity_logs")
}

model caregiver_condition_reports {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver_id         String             @map("caregiver_id") @db.Uuid
  patient_id           String             @map("patient_id") @db.Uuid
  report_type          String             @map("report_type") @db.VarChar(30)
  description          String             @map("description")
  severity             String             @default("MODERATE") @map("severity") @db.VarChar(20)
  alert_sent_to_nurse  Boolean            @default(false) @map("alert_sent_to_nurse")
  alert_sent_to_doctor Boolean            @default(false) @map("alert_sent_to_doctor")
  created_at           DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  caregiver            caregiver_profiles @relation(fields: [caregiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  patient              patients           @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("caregiver_condition_reports")
}

// ══════════════════════════════════════════════════════════════
// CG-006: GPS Check-In/Out — geofence-verified attendance
// ══════════════════════════════════════════════════════════════
model caregiver_check_in_out {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver_id        String             @map("caregiver_id") @db.Uuid
  patient_id          String             @map("patient_id") @db.Uuid
  check_in_time       DateTime?          @default(now()) @map("check_in_time") @db.Timestamptz(6)
  check_out_time      DateTime?          @map("check_out_time") @db.Timestamptz(6)
  check_in_latitude   Decimal?           @map("check_in_latitude") @db.Decimal(10, 7)
  check_in_longitude  Decimal?           @map("check_in_longitude") @db.Decimal(10, 7)
  check_out_latitude  Decimal?           @map("check_out_latitude") @db.Decimal(10, 7)
  check_out_longitude Decimal?           @map("check_out_longitude") @db.Decimal(10, 7)
  distance_meters     Decimal?           @map("distance_meters") @db.Decimal(8, 2)
  status              String             @default("CHECKED_IN") @map("status") @db.VarChar(20)
  created_at          DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime?          @default(now()) @map("updated_at") @db.Timestamptz(6)
  caregiver           caregiver_profiles @relation(fields: [caregiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  patient             patients           @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("caregiver_check_in_out")
}

// ══════════════════════════════════════════════════════════════
// CG-008: Timesheets — auto-generated from GPS check-in/out
// ══════════════════════════════════════════════════════════════
model caregiver_timesheets {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver_id  String             @map("caregiver_id") @db.Uuid
  patient_id    String             @map("patient_id") @db.Uuid
  shift_date    DateTime?          @default(now()) @map("shift_date") @db.Date
  check_in_time DateTime?          @map("check_in_time") @db.Timestamptz(6)
  check_out_time DateTime?         @map("check_out_time") @db.Timestamptz(6)
  total_hours   Decimal?           @map("total_hours") @db.Decimal(5, 2)
  service_type  String?            @map("service_type") @db.VarChar(20)
  status        String             @default("ACTIVE") @map("status") @db.VarChar(20)
  created_at    DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  caregiver     caregiver_profiles @relation(fields: [caregiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  patient       patients           @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("caregiver_timesheets")
}

model booking_sessions {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id   String            @map("patient_id") @db.Uuid
  booked_by    String?           @map("booked_by") @db.VarChar(255)
  agent_id     String?           @map("agent_id") @db.Uuid
  total_amount Decimal?          @map("total_amount") @db.Decimal(12, 2)
  status       String            @default("ACTIVE") @map("status") @db.VarChar(20)
  created_at   DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at   DateTime?         @default(now()) @map("updated_at") @db.Timestamptz(6)
  patient      patients          @relation(fields: [patient_id], references: [id], onUpdate: NoAction)
  payments     payments[]
  tickets      service_tickets[]
  invoices     invoices[]
  diagnosis_reports patient_diagnosis_reports[]

  @@map("booking_sessions")
}

model payments {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id               String           @map("patient_id") @db.Uuid
  booking_session_id       String           @map("booking_session_id") @db.Uuid
  amount                   Decimal          @map("amount") @db.Decimal(10, 2)
  currency                 String           @default("BDT") @map("currency") @db.VarChar(10)
  service_type             String           @map("service_type") @db.VarChar(30)
  stripe_payment_intent_id String           @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripe_client_secret     String?          @map("stripe_client_secret") @db.VarChar(255)
  status                   String           @default("pending") @map("status") @db.VarChar(20)
  created_at               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completed_at             DateTime?        @map("completed_at") @db.Timestamptz(6)
  booking_session          booking_sessions @relation(fields: [booking_session_id], references: [id], onUpdate: NoAction)
  patient                  patients         @relation(fields: [patient_id], references: [id], onUpdate: NoAction)
  invoice                  invoices?

  @@map("payments")
}

model invoices {
