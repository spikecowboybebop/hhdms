generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]

  @@map("roles")
}

model User {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                 @unique @db.VarChar(255)
  passwordHash          String                 @map("password_hash") @db.VarChar(255)
  phoneNumber           String                 @unique @map("phone_number") @db.VarChar(20)
  firstNameEn           String                 @map("first_name_en") @db.VarChar(100)
  lastNameEn            String                 @map("last_name_en") @db.VarChar(100)
  firstNameBn           String?                @map("first_name_bn") @db.VarChar(100)
  lastNameBn            String?                @map("last_name_bn") @db.VarChar(100)
  roleId                Int                    @map("role_id")
  status                AccountStatusEnum      @default(ACTIVE)
  mfaEnabled            Boolean                @default(false) @map("mfa_enabled")
  mfaSecret             String?                @map("mfa_secret") @db.VarChar(128)
  lastLoginAt           DateTime?              @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime?              @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt             DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?              @default(now()) @map("updated_at") @db.Timestamptz(6)
  mbbs_doctor_profiles  mbbs_doctor_profiles?
  nutritionist_profiles nutritionist_profiles?
  specialist_profiles   specialist_profiles?
  role                  Role                   @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  @@map("users")
}

model mbbs_doctor_profiles {
  user_id                  String    @id @db.Uuid
  bmdc_registration_number String    @unique @db.VarChar(50)
  digital_signature_url    String?   @db.VarChar(512)
  is_on_duty               Boolean   @default(false)
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  users                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nutritionist_profiles {
  user_id              String    @id @db.Uuid
  certification_number String    @unique @db.VarChar(50)
  is_on_duty           Boolean   @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  users                User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model specialist_profiles {
  user_id                  String    @id @db.Uuid
  bmdc_registration_number String    @unique @db.VarChar(50)
  specialty_code           String    @db.VarChar(20)
  digital_signature_url    String?   @db.VarChar(512)
  is_on_duty               Boolean   @default(false)
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  users                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum AccountStatusEnum {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("account_status_enum")
}
