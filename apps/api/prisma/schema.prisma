  referral_id String               @map("referral_id") @db.Uuid
  template_id String               @map("template_id") @db.Uuid
  form_data   Json                 @map("form_data")
  created_at  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  referral    specialist_referrals @relation(fields: [referral_id], references: [id], onDelete: Cascade)
  template    specialty_templates  @relation(fields: [template_id], references: [id])

  @@map("specialist_reports")
}

model teleconsultation_events {
  id                        String                    @id @db.Uuid
  session_id                String                    @db.Uuid
  event_type                String                    @db.VarChar(50)
  actor_id                  String?                   @db.Uuid
  actor_role                String?                   @db.VarChar(50)
  metadata                  Json?
  created_at                DateTime?                 @default(now()) @db.Timestamptz(6)
  teleconsultation_sessions teleconsultation_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([event_type])
  @@index([session_id])
}

model teleconsultation_sessions {
  id                      String                    @id @db.Uuid
  referral_id             String?                   @db.Uuid
  service_ticket_id       String?                   @db.Uuid
  patient_id              String                    @db.Uuid
  initiator_id            String?                   @db.Uuid
  initiator_role          String                    @default("SPECIALIST") @db.VarChar(50)
  room_name               String                    @unique @db.VarChar(255)
  room_url                String                    @db.VarChar(512)
  meter_room_id           String?                   @db.VarChar(255)
  status                  String                    @default("PENDING") @db.VarChar(50)
  started_at              DateTime?                 @db.Timestamptz(6)
  ended_at                DateTime?                 @db.Timestamptz(6)
  duration_seconds        Int?
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  teleconsultation_events teleconsultation_events[]
  patients                patients                  @relation(fields: [patient_id], references: [id])
  specialist_referrals    specialist_referrals?     @relation(fields: [referral_id], references: [id])
  service_tickets         service_tickets?          @relation(fields: [service_ticket_id], references: [id])
}

