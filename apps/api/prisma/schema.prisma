// SRS 4.2 — Immutable Audit Logging (admin module operations)
// Append-only: rows are inserted only, never updated or deleted. Each row is
// chained to the previous row's content_hash via SHA-256 so that any deletion
// or modification breaks the chain and is detectable by the verify endpoint.
model system_audit_logs {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(50)
  action       String   @map("action") @db.VarChar(50)
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.Uuid
  changes      Json?    @map("changes")
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  prevHash     String   @default("") @map("prev_hash") @db.VarChar(64)
  contentHash  String   @map("content_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_audit_logs")
}

