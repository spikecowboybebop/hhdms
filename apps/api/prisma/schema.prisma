model nurse_profiles {
  user_id           String  @id @map("user_id") @db.Uuid
  nurse_type        String? @map("nurse_type") @db.VarChar(50)
  specialization    String? @map("specialization") @db.VarChar(100)
  license_number    String? @map("license_number") @db.VarChar(50)
  bnmc_registration String? @unique @map("bnmc_registration") @db.VarChar(50)
  qualifications    String? @map("qualifications") @db.VarChar(255)
  skills            String? @map("skills") @db.VarChar(255)
  shift_preference  String? @map("shift_preference") @db.VarChar(50)
  gps_device_id     String? @map("gps_device_id") @db.VarChar(100)
  created_at        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  patient_assignments         nurse_patient_assignments[]
  schedule_entries            nurse_schedule_entries[]
  vital_signs                 nurse_vital_signs[]
  medication_administrations  nurse_medication_administrations[]
  iv_fluid_records            nurse_iv_fluid_records[]
  wound_care_records          nurse_wound_care_records[]
  care_reports                nurse_care_reports[]
  handovers                   nurse_handovers[]
  consultation_requests       nurse_consultation_requests[]
  supply_usage                nurse_supply_usage[]
  feeding_logs                nurse_feeding_logs[]
  growth_records              nurse_growth_records[]
  vaccination_records         nurse_vaccination_records[]

  @@map("nurse_profiles")
}

model nurse_patient_assignments {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nurse_id     String          @map("nurse_id") @db.Uuid
  patient_id   String          @map("patient_id") @db.Uuid
  assigned_at  DateTime?       @default(now()) @map("assigned_at") @db.Timestamptz(6)
  status       String          @default("ACTIVE") @map("status") @db.VarChar(20)
  nurse        nurse_profiles  @relation(fields: [nurse_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  patient      patients        @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([nurse_id, patient_id])
  @@map("nurse_patient_assignments")
}

model nurse_schedule_entries {
